{
  "name": "kizuna",
  "private": true,
  "version": "2.0.0-beta.28",
  "scripts": {
    "dev": "pnpm build && concurrently -n express,hono,next -c cyan,yellow,magenta \"pnpm --filter @kizunajs-demo/express dev\" \"pnpm --filter @kizunajs-demo/hono dev\" \"pnpm --filter @kizunajs-demo/next dev\"",
    "build": "pnpm -r --filter \"./packages/*\" build && pnpm typecheck && pnpm generate:swift",
    "build:demos": "pnpm -r --filter \"./apps/*\" --filter \"!@kizunajs-demo/swift\" --filter \"!@kizunajs-demo/kotlin\" build",
    "build:docs": "pnpm --filter docs build",
    "typecheck": "pnpm -r typecheck",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "test": "vitest run && pnpm test:swift",
    "test:ts": "vitest run",
    "test:watch": "vitest",
    "test:types": "vitest --typecheck.only",
    "test:exports": "pnpm -r --filter \"./packages/*\" exec attw --pack . --profile node16 --ignore-rules false-export-default && pnpm -r --filter \"./packages/*\" exec publint --strict",
    "generate:openapi": "pnpm -r --filter \"@kizunajs-demo/express\" --filter \"@kizunajs-demo/hono\" --filter \"@kizunajs-demo/fastify\" --filter \"@kizunajs-demo/next\" openapi",
    "generate:swift": "pnpm --filter @kizunajs-demo/swift generate",
    "test:swift": "pnpm --filter @kizunajs-demo/swift test",
    "swift:build": "pnpm --filter @kizunajs-demo/swift build",
    "generate:kotlin": "pnpm --filter @kizunajs-demo/kotlin generate",
    "test:kotlin": "pnpm --filter @kizunajs-demo/kotlin test",
    "kotlin:build": "pnpm --filter @kizunajs-demo/kotlin build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm --filter kizunajs --filter @kizunajs/eslint-plugin build && eslint .",
    "lint:fix": "pnpm --filter @kizunajs/eslint-plugin build && eslint . --fix",
    "docs": "pnpm --filter docs dev",
    "release": "release-it",
    "kizuna:generate": "pnpm -r --filter \"@kizunajs-demo/express\" --filter \"@kizunajs-demo/fastify\" --filter \"@kizunajs-demo/hono\" --filter \"@kizunajs-demo/next\" kizuna:generate",
    "kizuna:check": "pnpm -r --filter \"@kizunajs-demo/express\" --filter \"@kizunajs-demo/fastify\" --filter \"@kizunajs-demo/hono\" --filter \"@kizunajs-demo/next\" kizuna:check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.5",
    "@kizunajs/eslint-plugin": "workspace:*",
    "@kizunajs/fetch": "workspace:*",
    "@release-it/conventional-changelog": "^11.0.1",
    "@types/supertest": "^6.0.3",
    "@vscode/vsce": "^3.9.2",
    "concurrently": "catalog:",
    "esbuild": "^0.28.2",
    "eslint": "catalog:",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^64.5.4",
    "eslint-plugin-prettier": "^5.5.7",
    "jest-expect-openapi": "^6.3.1",
    "ovsx": "^1.3.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "release-it": "^20.2.1",
    "supertest": "^7.3.2",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.72.1",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@11.28.9+sha512.35421cea2720eca3f5ad722b67e8ef18f4d3cd4745ed2fcfeb0dc288d4e9437fad3870d91ee6e83f268f0f6f7e0f62723317b19617bb45ee4333172ef51159f8"
}
