{
  "name": "@kizunajs/tanstack-query",
  "version": "2.0.0-beta.4",
  "description": "TanStack Query client for Kizuna.js",
  "keywords": [
    "kizunajs",
    "typescript",
    "zod",
    "openapi",
    "spec-driven",
    "type-safe",
    "rest",
    "api",
    "tanstack-query",
    "react-query",
    "query-options",
    "typed-client"
  ],
  "license": "MIT",
  "homepage": "https://kizunajs.com/docs/clients/tanstack-query",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kizunajs/kizuna.git",
    "directory": "packages/tanstack-query"
  },
  "bugs": "https://github.com/kizunajs/kizuna/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "kizuna": {
    "entries": {
      ".": "client"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm,cjs --dts --clean --external kizunajs --external @kizunajs/fetch --external @tanstack/query-core --external zod",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@tanstack/query-core": "^5.69.0",
    "kizunajs": "workspace:*",
    "@kizunajs/fetch": "workspace:*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tanstack/query-core": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/svelte-query": "catalog:",
    "@tanstack/vue-query": "catalog:",
    "kizunajs": "workspace:*",
    "@kizunajs/fetch": "workspace:*",
    "@types/react": "catalog:",
    "react": "catalog:",
    "svelte": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vue": "catalog:",
    "zod": "catalog:"
  }
}
