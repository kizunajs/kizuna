{
  "name": "@kizunajs/fetch",
  "version": "2.0.0-beta.8",
  "description": "Typed fetch client for Kizuna.js APIs",
  "keywords": [
    "kizunajs",
    "typescript",
    "zod",
    "openapi",
    "spec-driven",
    "type-safe",
    "rest",
    "api",
    "client",
    "fetch",
    "rpc",
    "typed-client"
  ],
  "license": "MIT",
  "homepage": "https://kizunajs.com/docs/clients/fetch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kizunajs/kizuna.git",
    "directory": "packages/fetch"
  },
  "bugs": "https://github.com/kizunajs/kizuna/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.mts",
        "default": "./dist/server.mjs"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    }
  },
  "kizuna": {
    "entries": {
      ".": "client",
      "./server": "server"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/server.ts --format esm,cjs --dts --clean --external kizunajs --external zod",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "kizunajs": "workspace:*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "kizunajs": "workspace:*",
    "@kizunajs/express": "workspace:*",
    "@types/express": "catalog:",
    "express": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
