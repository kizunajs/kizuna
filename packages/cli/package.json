{
  "name": "@kizunajs/cli",
  "version": "2.0.0-beta.9",
  "description": "Command line tooling for Kizuna.js",
  "keywords": [
    "kizunajs",
    "typescript",
    "zod",
    "openapi",
    "spec-driven",
    "type-safe",
    "rest",
    "api",
    "codegen"
  ],
  "license": "MIT",
  "homepage": "https://kizunajs.com/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kizunajs/kizuna.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/kizunajs/kizuna/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "kizuna": "./dist/cli.mjs"
  },
  "kizuna": {
    "entries": {
      ".": "server"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/cli.ts --format esm,cjs --dts --clean --external kizunajs --external zod --external jiti --external typescript",
    "prepare": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jiti": "^2.7.0",
    "typescript": "catalog:",
    "yaml": "^2.8.4"
  },
  "peerDependencies": {
    "kizunajs": "workspace:*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "kizunajs": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "tsdown": "catalog:",
    "zod": "catalog:"
  }
}
