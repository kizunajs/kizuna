{
  "name": "@kizunajs/kotlin",
  "version": "2.0.0-beta.0",
  "description": "Kotlin client generation for Kizuna.js APIs",
  "keywords": [
    "kizunajs",
    "typescript",
    "zod",
    "openapi",
    "spec-driven",
    "type-safe",
    "rest",
    "api",
    "kotlin",
    "android",
    "jvm",
    "codegen",
    "client-generation"
  ],
  "license": "MIT",
  "homepage": "https://kizunajs.com/docs/clients/kotlin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kizunajs/kizuna.git",
    "directory": "packages/kotlin"
  },
  "bugs": "https://github.com/kizunajs/kizuna/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "kizuna-kotlin": "./dist/cli.mjs"
  },
  "kizuna": {
    "entries": {
      ".": "server"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/cli.ts --format esm,cjs --dts --clean --external kizunajs --external @kizunajs/cli --external zod",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kizunajs/cli": "workspace:*"
  },
  "peerDependencies": {
    "kizunajs": "workspace:*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "kizunajs": "workspace:*",
    "@types/node": "^22.9.0",
    "tsdown": "^0.21.0",
    "typescript": "catalog:",
    "zod": "^4.0.0"
  }
}
