{
  "name": "@kizunajs/eslint-plugin",
  "version": "2.0.0-beta.4",
  "description": "ESLint rules for Kizuna.js",
  "keywords": [
    "kizunajs",
    "typescript",
    "zod",
    "openapi",
    "spec-driven",
    "type-safe",
    "rest",
    "api",
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "lint"
  ],
  "license": "MIT",
  "homepage": "https://kizunajs.com/docs/eslint",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kizunajs/kizuna.git",
    "directory": "packages/eslint-plugin"
  },
  "bugs": "https://github.com/kizunajs/kizuna/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "kizuna": {
    "entries": {
      ".": "server"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm,cjs --dts --clean --external eslint --external typescript --external @typescript-eslint/utils --external @typescript-eslint/parser --external kizunajs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/utils": "^8.0.0"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0",
    "typescript": ">=5.0.0",
    "kizunajs": "workspace:*"
  },
  "devDependencies": {
    "kizunajs": "workspace:*",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
