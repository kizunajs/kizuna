{
  "name": "@kizunajs/fastify",
  "version": "2.0.0-beta.4",
  "description": "Fastify adapter for Kizuna.js",
  "keywords": [
    "kizunajs",
    "typescript",
    "zod",
    "openapi",
    "spec-driven",
    "type-safe",
    "rest",
    "api",
    "fastify",
    "adapter",
    "server"
  ],
  "license": "MIT",
  "homepage": "https://kizunajs.com/docs/adapters/fastify",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kizunajs/kizuna.git",
    "directory": "packages/fastify"
  },
  "bugs": "https://github.com/kizunajs/kizuna/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "kizuna": {
    "entries": {
      ".": "server"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm,cjs --dts --clean --external kizunajs --external fastify --external fastify-plugin --external zod",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fastify-plugin": "^5.1.0"
  },
  "peerDependencies": {
    "kizunajs": "workspace:*",
    "fastify": "^5.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "kizunajs": "workspace:*",
    "fastify": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
