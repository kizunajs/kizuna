{
  "name": "@kizunajs-demo/next",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "pglite-server --db=.pglite --port=5499 --max-connections=20 --run \"tsx scripts/setup-demo.ts && next dev -p 3030\"",
    "build": "pglite-server --db=.pglite --port=5499 --max-connections=20 --run \"tsx scripts/setup-demo.ts && next build\"",
    "start": "pglite-server --db=.pglite --port=5499 --max-connections=20 --run \"next start -p 3030\"",
    "typecheck": "tsc --noEmit",
    "openapi": "tsx scripts/generate-openapi.ts",
    "kizuna:generate": "kizuna generate",
    "kizuna:check": "kizuna generate --check",
    "demo:setup": "tsx scripts/setup-demo.ts",
    "db": "pglite-server --db=.pglite --port=5499 --max-connections=20"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@kizunajs-demo/shared": "workspace:*",
    "@kizunajs/cms": "workspace:*",
    "@kizunajs/fetch": "workspace:*",
    "@kizunajs/mcp": "workspace:*",
    "@kizunajs/next": "workspace:*",
    "@kizunajs/openapi": "workspace:*",
    "@scalar/nextjs-api-reference": "^0.10.11",
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "kizunajs": "workspace:*",
    "next": "catalog:",
    "postgres": "^3.4.9",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@kizunajs/cli": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
