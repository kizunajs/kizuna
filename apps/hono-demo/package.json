{
  "name": "@kizunajs-demo/hono",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"tsx watch src/index.ts\" \"sleep 1.5 && tsx src/scripts/run-client.ts\"",
    "server": "tsx watch src/index.ts",
    "server:once": "tsx src/index.ts",
    "client": "tsx src/scripts/run-client.ts",
    "typecheck": "tsc --noEmit",
    "openapi": "tsx scripts/generate-openapi.ts",
    "kizuna:generate": "kizuna generate",
    "kizuna:check": "kizuna generate --check"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@kizunajs-demo/shared": "workspace:*",
    "kizunajs": "workspace:*",
    "@kizunajs/fetch": "workspace:*",
    "@kizunajs/hono": "workspace:*",
    "@kizunajs/mcp": "workspace:*",
    "@kizunajs/openapi": "workspace:*",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@kizunajs/cli": "workspace:*",
    "@types/node": "catalog:",
    "concurrently": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
